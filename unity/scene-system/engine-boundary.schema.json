{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine-boundary.schema.json",
  "title": "GameCraft engine boundary",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "packageTarget", "runtime", "forbiddenPortableTerms"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "packageTarget": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portableNow", "adapterNeeded", "gameOwned"],
      "properties": {
        "portableNow": { "$ref": "#/$defs/fileList" },
        "adapterNeeded": { "$ref": "#/$defs/fileList" },
        "gameOwned": { "$ref": "#/$defs/fileList" }
      }
    },
    "forbiddenPortableTerms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "fileList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.cs$" }
    }
  }
}
