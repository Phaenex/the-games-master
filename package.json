{
  "name": "the-games-master",
  "version": "0.1.0",
  "private": true,
  "description": "A first-person psychological-horror game targeting Steam in Unity HDRP.",
  "scripts": {
    "assets:horror:check": "node scripts/check-horror-bundle.mjs",
    "serve": "npx serve .",
    "test": "npm run test:fast && npm run test:archive:web",
    "test:fast": "node scripts/test-harness-integrity.mjs && node scripts/test-scene-learning.mjs && node scripts/test-unity-scene-system.mjs && node scripts/test-unity-runtime-integrity.mjs && node scripts/test-shutbox.mjs",
    "test:archive:web": "node scripts/run-tests.mjs",
    "test:all": "npm run verify:portable",
    "test:logic": "node scripts/test-shutbox.mjs",
    "test:logic:csharp": "node scripts/test-shutbox-csharp.mjs",
    "test:scene-system": "node scripts/test-unity-scene-system.mjs",
    "test:scene-learning": "node scripts/test-scene-learning.mjs",
    "test:unity-integrity": "node scripts/test-unity-runtime-integrity.mjs",
    "test:scene-system:csharp": "node scripts/test-unity-scaffold-csharp.mjs",
    "test:unity": "node scripts/unity-cli.mjs test",
    "test:harness": "npm run test:archive:web",
    "playtest:agent": "node scripts/agent-playtest.mjs",
    "gates": "npm run verify:opening",
    "verify:portable": "npm run test:logic:csharp && npm test && npm run unity:scene:check && npm run test:scene-system:csharp",
    "verify:opening": "npm run verify:harness && npm run verify:attribution && node scripts/run-opening-gates.mjs",
    "verify:frames": "node scripts/scan-frame-defects.mjs \"./unity-project/Library/GmSceneIntelligence/standalone-proof/wend-hill-prologue\" \"./unity-project/Library/GmSceneIntelligence/player-probes/wend-hill-prologue\" \"./unity-project/Screens/WendHill_Prologue\"",
    "verify:attribution": "node scripts/test-attribution.mjs",
    "unity:scene:registry": "node scripts/unity-cli.mjs scenes",
    "unity:scene:check": "node scripts/unity-cli.mjs registry-check && node scripts/sync-unity-scenes.mjs --check && node scripts/check-unity-packages.mjs",
    "unity:packages:check": "node scripts/check-unity-packages.mjs",
    "unity:scene:sync": "node scripts/sync-unity-scenes.mjs",
    "unity:build:mac": "node scripts/unity-cli.mjs build-mac",
    "unity:proof:mac": "node scripts/unity-cli.mjs standalone-proof",
    "unity:proof:walk": "node scripts/unity-cli.mjs walk-proof",
    "unity:proof:walls": "node scripts/unity-cli.mjs wall-proof",
    "unity:proof:house": "node scripts/unity-cli.mjs house-proof",
    "unity:tour": "node scripts/unity-cli.mjs tour",
    "unity:playtest": "node scripts/unity-cli.mjs playtest",
    "unity:assets:index": "node scripts/unity-cli.mjs asset-index",
    "unity:assets:victorian": "node scripts/sync-victorian-proof-assets.mjs",
    "unity:assets:victorian:check": "node scripts/sync-victorian-proof-assets.mjs --check",
    "unity:scene:report": "node scripts/unity-cli.mjs report",
    "unity:pacing": "node scripts/unity-cli.mjs pacing",
    "unity:variants": "node scripts/unity-cli.mjs variants",
    "unity:host": "node scripts/unity-cli.mjs host-health",
    "unity:learning": "node scripts/scene-learning.mjs status",
    "verify:harness": "node scripts/test-harness-integrity.mjs"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  }
}
